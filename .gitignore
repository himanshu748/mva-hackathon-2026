# Challenge data. Gated, patient-derived, must never be redistributed.
# Hackathon Rules: "No data may be reshared through any channel."
data/
out/
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.fastq.gz
*.bam
*.cram
*.docx

# Derived intermediates also count as challenge data under the Rules
# ("any intermediate or derived datasets") and must be deleted after close.
*.tsv
*.jsonl
*.pkl
baf_raw*
vep_parts/

# Public reference files, regenerated by the scripts on demand
ref/

# Secrets
.env

__pycache__/
*.pyc

# Organizer code, fetched on demand by 03_verify.sh
scripts/_organizer_evaluation.py

# Public GEO study summaries, unrelated to the challenge patient
!report/public_mouse_audit/**/*.tsv
!report/heart_evidence_audit/inputs/prior_panel_contrasts.tsv
